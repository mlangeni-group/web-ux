{
  "name": "@mlangeni-group/web-ux",
  "version": "1.4.1",
  "description": "Browser-first frontend utilities for HTTP, Bootstrap, forms, i18n, storage, and accessibility",
  "type": "module",
  "main": "./dist/web-ux.cjs",
  "module": "./dist/web-ux.mjs",
  "browser": "./dist/web-ux.mjs",
  "types": "./lib/types.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types.d.ts",
      "browser": "./dist/web-ux.mjs",
      "import": "./dist/web-ux.mjs",
      "require": "./dist/web-ux.cjs",
      "default": "./dist/web-ux.mjs"
    },
    "./browser": "./dist/web-ux.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "index.js",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "bootstrap": "^5.0.0",
    "jquery": "^3.6.0"
  },
  "keywords": [
    "frontend",
    "jquery",
    "bootstrap",
    "ajax",
    "encryption",
    "validation",
    "i18n",
    "accessibility",
    "offline"
  ],
  "license": "MIT",
  "author": "Precious Lyson, Mlangeni Group",
  "devDependencies": {
    "bootstrap": "^5.3.9",
    "esbuild": "^0.25.12",
    "jquery": "^3.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlangeni-group/web-ux.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
